{
  "name": "@ursainyk/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma 7 schema, migrations, seed, client — the single owner of the RDS schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint) @ursainyk/db — no linter configured yet\"",
    "test": "echo \"(test) @ursainyk/db — no tests yet\"",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.0",
    "@ursainyk/config": "workspace:*",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "pg": "^8.16.0"
  }
}
