{
  "name": "@ergaxis/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma 7 schema, migrations, seed, client \u2014 the single owner of the RDS schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint) @ergaxis/db \u2014 no linter configured yet\"",
    "test": "echo \"(test) @ergaxis/db \u2014 no tests yet\"",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@ergaxis/config": "workspace:*",
    "typescript": "~5.9.3",
    "prisma": "^7.9.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.20.0",
    "@types/pg": "^8.15.0",
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.16.0"
  }
}
