# Copy to .env — never commit real values. Production secrets live in AWS SSM/Secrets Manager.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nabhahita:nabhahita@localhost:5432/nabhahita
REDIS_URL=redis://localhost:6379
# S3-compatible (MinIO locally, S3 ap-south-1 in prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nabhahita-documents
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
# Auth (placeholders — rotate per environment)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Providers (empty until integrations workstream)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_NOTIFY_TEMPLATE_ID=
# 1 = refuse admin logins without a verified TOTP authenticator (production posture, ADR-0004)
ADMIN_MFA_ENFORCE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Email: Mailpit locally (compose), SES SMTP in production
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ursainyk.local
SMTP_USER=
SMTP_PASS=
SES_REGION=ap-south-1
FCM_SERVICE_ACCOUNT_JSON=
# Parser (ADR-0008): key present -> Gemini vision parser; absent -> deterministic dev stub
GEMINI_API_KEY=
PARSER_MODEL=gemini-2.5-flash
# Antivirus (optional): set host to enable clamd scanning in the ingestion pipeline (fail-closed when set)
CLAMD_HOST=
CLAMD_PORT=3310
SENTRY_DSN=
